# ==============================================================================
# CAROL - .gitignore
# ==============================================================================

# Ambientes Virtuais Python
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Bytecode e Caches Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Caches de Testes e Cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Variáveis de Ambiente e Segredos
.env
.env.local
.env.*.local
*.key
*.pem
*.crt

# Banco de Dados Local (SQLite)
*.sqlite
*.sqlite3
*.db
carol_data.sqlite
carol_data.sqlite-shm
carol_data.sqlite-wal

# Certidões em PDF Baixadas Automaticamente
certidoes/*
!certidoes/.gitkeep

# Arquivos de Log
*.log
logs/

# Arquivos do Sistema Operacional (macOS, Windows, Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs e Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
