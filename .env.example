# ==============================================================================
# CAROL - CONFIGURAÇÕES DE PRODUÇÃO E AMBIENTE (.env)
# ==============================================================================

# URL Base pública do sistema (usada em webhooks, links de certidões e proxy reverso)
# Em produção, informe o domínio com HTTPS (ex: https://carol.suaempresa.com.br)
BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# BANCO DE DADOS: POSTGRESQL (PRODUÇÃO)
# ------------------------------------------------------------------------------
# Opção 1: String de conexão completa
DATABASE_URL=postgresql://carol_user:carol_secret_123@localhost:5432/carol_db

# Opção 2: Variáveis separadas (utilizadas no Docker Compose)
POSTGRES_USER=carol_user
POSTGRES_PASSWORD=carol_secret_123
POSTGRES_DB=carol_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# ARMAZENAMENTO E WEBHOOKS
# ------------------------------------------------------------------------------
# Diretório para armazenamento local de certidões PDF baixadas
CAROL_CERTIDOES_DIR=./certidoes

# URL opcional de Webhook global (caso deseje disparar para um canal geral de monitoramento)
CAROL_WEBHOOK_URL=
